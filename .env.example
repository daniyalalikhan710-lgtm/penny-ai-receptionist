# Copy to .env.local and fill in. Never commit .env.local.

# --- AI engine -------------------------------------------------------------
# Your Anthropic API key (console.anthropic.com -> API keys). Use a separate
# key for this demo and set a spend limit on it.
# Leave blank to run Penny in replay mode: scripted conversations that still
# use the real tools, price book, calendar and dashboard. No key, no cost.
ANTHROPIC_API_KEY=

# Which Claude model powers Penny in live mode. Default: claude-opus-5-5.
# claude-haiku-5-5 also works and is much cheaper.
ANTHROPIC_MODEL=claude-opus-5-5

# Reasoning effort: low | medium | high | xhigh | max. Default: low (snappy chat).
# Keep it the same for every turn: changing it invalidates the prompt cache.
ANTHROPIC_EFFORT=low

# Set to "replay" to force the scripted engine even when a key is present.
PENNY_MODE=

# --- Demo banner -----------------------------------------------------------
# Shown as "Built by ___ · Hire me". If either is blank the link is hidden.
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_HIRE_URL=

# --- Cost and abuse limits (all optional; defaults shown) -------------------
# Customer messages per conversation.
PENNY_MAX_TURNS=30
# Characters per customer message.
PENNY_MAX_MESSAGE_CHARS=1500
# Photos per conversation (enough to try every sample), and how many of
# those may be the visitor's own uploads.
PENNY_MAX_IMAGES=6
PENNY_MAX_UPLOADS=3
# max_tokens per model step.
PENNY_MAX_TOKENS=4096
# Requests per IP per minute / per day.
PENNY_RATE_PER_MINUTE=20
PENNY_RATE_PER_DAY=200
# Total characters of text and tool data in one conversation's history.
PENNY_MAX_TRANSCRIPT_CHARS=60000
# Daily live budget across ALL visitors: a number of turns and an estimated
# dollar amount. When either is used up, Penny answers in replay mode until
# the next UTC day. Without Upstash (below) these counters are kept per server
# instance, so on serverless hosting they slow spending down but do not cap it:
# ALSO set a hard spend limit on the API key itself in the Anthropic console.
PENNY_DAILY_LIVE_TURNS=1500
PENNY_DAILY_BUDGET_USD=5

# --- Optional: Upstash Redis, shared across serverless instances -----------
# Makes the per-IP rate limit and the daily budget above real, shared limits.
# Recommended for any public link that runs in live mode. Without these, an
# in-memory limiter is used (per instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Only if you host somewhere other than Vercel ---------------------------
# The request header YOUR proxy sets to the visitor's address (for example
# cf-connecting-ip). On Vercel leave this blank: the platform's header is used.
PENNY_CLIENT_IP_HEADER=

# --- Development only ------------------------------------------------------
# Replay typing speed multiplier: 1 = natural, 0 = instant (tests).
PENNY_REPLAY_PACE=
# Simulated payment processing delay in ms. Default 900.
PENNY_PAY_DELAY_MS=
