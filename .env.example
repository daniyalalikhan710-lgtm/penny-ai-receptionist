# Copy to .env.local and fill in. Never commit .env.local.

# --- AI engine -------------------------------------------------------------
# Your Anthropic API key (console.anthropic.com -> API keys). Use a separate
# key for this demo and set a spend limit on it.
# Leave blank to run Penny in replay mode: scripted conversations that still
# use the real tools, price book, calendar and dashboard. No key, no cost.
ANTHROPIC_API_KEY=

# Which Claude model powers Penny in live mode. Default: claude-opus-5-5.
# claude-haiku-5-5 also works and is much cheaper.
ANTHROPIC_MODEL=claude-opus-5-5

# Reasoning effort: low | medium | high | xhigh | max. Default: low (snappy chat).
# Keep it the same for every turn: changing it invalidates the prompt cache.
ANTHROPIC_EFFORT=low

# Set to "replay" to force the scripted engine even when a key is present.
PENNY_MODE=

# --- Demo banner -----------------------------------------------------------
# Shown as "Built by ___ · Hire me". If either is blank the link is hidden.
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_HIRE_URL=

# --- Cost and abuse limits (all optional; defaults shown) -------------------
# Customer messages per conversation.
PENNY_MAX_TURNS=30
# Characters per customer message.
PENNY_MAX_MESSAGE_CHARS=1500
# Photos per conversation.
PENNY_MAX_IMAGES=3
# max_tokens per model step.
PENNY_MAX_TOKENS=4096
# Requests per IP per minute / per day.
PENNY_RATE_PER_MINUTE=20
PENNY_RATE_PER_DAY=200
# Live model turns across ALL visitors per day; after that Penny falls back to
# replay mode instead of spending more.
PENNY_DAILY_LIVE_TURNS=1500

# --- Optional: Upstash Redis for rate limiting across serverless instances --
# Without these, an in-memory limiter is used (per instance, fine for a demo).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Development only ------------------------------------------------------
# Replay typing speed multiplier: 1 = natural, 0 = instant (tests).
PENNY_REPLAY_PACE=
# Simulated payment processing delay in ms. Default 900.
PENNY_PAY_DELAY_MS=
